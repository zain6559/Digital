NOOR_ENV=development
NOOR_BACKEND_HOST=0.0.0.0
NOOR_BACKEND_PORT=8000
NEXT_PUBLIC_API_URL=http://localhost:8000
DATABASE_URL=postgresql+asyncpg://noor:noor@postgres:5432/noor
SYNC_DATABASE_URL=postgresql://noor:noor@postgres:5432/noor
REDIS_URL=redis://redis:6379/0
QDRANT_URL=http://qdrant:6333
LLM_MODE=hybrid
LOCAL_LLM_BASE_URL=http://host.docker.internal:11434
LOCAL_MODEL_NAME=local-model
CLOUD_MODEL_NAME=gpt-4.1-mini
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
HYBRID_FALLBACK_ENABLED=true
NOOR_REQUIRE_CONFIRMATION_FOR_HIGH_RISK=true
NOOR_ENABLE_MOBILE_BRIDGE=true
NOOR_ENABLE_BROWSER_AUTOMATION=true
NOOR_ENABLE_PUBLIC_POSTING=false
